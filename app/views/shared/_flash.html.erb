<% if flash.any? %>
  <div class="space-y-3 mb-6">
    <% if notice = flash[:notice] %>
      <div class="p-4 rounded-lg bg-green-50 border border-green-200 text-green-800 text-sm flex items-center justify-between" role="alert" id="notice">
        <span><%= notice %></span>
      </div>
    <% end %>

    <% if alert = flash[:alert] %>
      <div class="p-4 rounded-lg bg-red-50 border border-red-200 text-red-800 text-sm flex items-center justify-between" role="alert" id="alert">
        <span><%= alert %></span>
      </div>
    <% end %>
  </div>
<% end %>
